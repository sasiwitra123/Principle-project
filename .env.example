# คัดลอกเป็น .env (ห้าม commit) หรือตั้งเป็น Environment Variables ก่อนรัน
DB_URL=jdbc:postgresql://localhost:5432/principlesproject
DB_USERNAME=postgres
DB_PASSWORD=ใส่รหัสผ่านใหม่ของคุณ
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ตั้งรหัสแอดมินเอง
